generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity & tenancy ----------

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  legalName   String
  displayName String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  properties   Property[]
  guests       Guest[]
  auditLogs    AuditLog[]
  subscription Subscription?

  @@map("tenants")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String
  active          Boolean   @default(true)
  mfaSecretEnc    String?
  mfaEnabled      Boolean   @default(false)
  emailVerifiedAt DateTime?
  sessionEpoch    Int       @default(0) // bump to revoke all sessions
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]

  @@map("users")
}

model Membership {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String   @db.Uuid
  role             String // RoleKey
  extraPermissions String[] @default([])
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  properties UserProperty[]

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model Property {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  name               String
  address            String?
  timezone           String   @default("Asia/Kolkata")
  currency           String   @default("INR")
  checkInTime        String   @default("14:00")
  checkOutTime       String   @default("11:00")
  legalName          String?
  gstRegistered      Boolean  @default(false)
  gstin              String?
  gstStateCode       String?
  invoicePrefix      String   @default("INV")
  // Profile
  code               String?
  phone              String?
  email              String?
  description        String?
  amenities          String[] @default([])
  logoUrl            String?
  imageUrls          String[] @default([])
  operationalAddress String?
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  users        UserProperty[]
  roomTypes    RoomType[]
  rooms        Room[]
  buildings    Building[]
  floors       Floor[]
  reservations Reservation[]
  tasks        HousekeepingTask[]
  maintenance  MaintenanceRequest[]
  folios       Folio[]
  shifts       CashShift[]
  invoices     Invoice[]
  ratePlans    RatePlan[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("properties")
}

model UserProperty {
  membershipId String @db.Uuid
  propertyId   String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id])
  property   Property   @relation(fields: [propertyId], references: [id])

  @@id([membershipId, propertyId])
  @@map("user_property_roles")
}

// ---------- Rooms ----------

model RoomType {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  propertyId          String   @db.Uuid
  name                String
  maxAdults           Int      @default(2)
  maxChildren         Int      @default(0)
  baseRateMinor       Int      @default(0) // integer minor units (paise)
  /// Adults included in the base rate; each extra adult is charged per night.
  baseOccupancy       Int      @default(2)
  extraAdultRateMinor Int      @default(0)
  extraChildRateMinor Int      @default(0) // per child per night; 0 = children stay free
  description         String?
  bedConfig           String?
  amenities           String[] @default([])
  code                String?
  active              Boolean  @default(true)
  imageUrls           String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  property  Property       @relation(fields: [propertyId], references: [id])
  rooms     Room[]
  planRates RatePlanRate[]

  @@index([tenantId, propertyId])
  @@map("room_types")
}

/// A building or wing of a property. Deactivated, never deleted, once rooms reference it.
model Building {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  name       String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  floors   Floor[]
  rooms    Room[]

  @@unique([propertyId, name])
  @@index([tenantId, propertyId])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  buildingId String   @db.Uuid
  label      String
  level      Int      @default(0)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])
  rooms    Room[]

  @@unique([buildingId, label])
  @@index([tenantId, propertyId])
  @@map("floors")
}

model Room {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  propertyId   String    @db.Uuid
  roomTypeId   String    @db.Uuid
  number       String
  // Operational status; separate from booking state.
  housekeeping String    @default("CLEAN") // CLEAN | DIRTY | CLEANING | INSPECTED
  outOfOrder   Boolean   @default(false)
  floor        Int?
  buildingId   String?   @db.Uuid
  floorId      String?   @db.Uuid
  /// Tile position on the floor plan grid (0-based); null = not yet placed.
  layoutX      Int?
  layoutY      Int?
  name         String?
  /// Do Not Disturb: a housekeeping access restriction, separate from cleaning state and occupancy.
  dnd          Boolean   @default(false)
  dndAt        DateTime?
  active       Boolean   @default(true)
  archivedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  property      Property             @relation(fields: [propertyId], references: [id])
  roomType      RoomType             @relation(fields: [roomTypeId], references: [id])
  building      Building?            @relation(fields: [buildingId], references: [id])
  floorRef      Floor?               @relation(fields: [floorId], references: [id])
  assignments   RoomAssignment[]
  tasks         HousekeepingTask[]
  maintenance   MaintenanceRequest[]
  statusHistory RoomStatusHistory[]

  @@unique([propertyId, number])
  @@index([tenantId, propertyId])
  @@map("rooms")
}

// ---------- Guests & reservations ----------

model Guest {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  phone        String?
  email        String?
  notes        String?
  companyName  String?
  gstin        String?
  gstStateCode String?
  address      String?
  idType       String?
  idNumberEnc  String? // AES-GCM encrypted; shown masked
  /// Last 10 digits of the phone, for matching across formats. `phone` keeps the text exactly as typed.
  phoneKey     String?
  nationality  String?
  preferences  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reservations Reservation[]
  folios       Folio[]

  @@index([tenantId])
  @@index([tenantId, phoneKey])
  @@map("guests")
}

model Reservation {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @db.Uuid
  propertyId              String    @db.Uuid
  reference               String
  guestId                 String    @db.Uuid
  roomTypeId              String    @db.Uuid
  source                  String    @default("DIRECT")
  arrival                 DateTime  @db.Date
  departure               DateTime  @db.Date
  adults                  Int       @default(1)
  children                Int       @default(0)
  status                  String    @default("CONFIRMED")
  notes                   String?
  createdBy               String    @db.Uuid
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  // Booking details (multi-room bookings share a groupRef)
  groupRef                String?
  companyName             String?
  agentName               String?
  ratePlan                String    @default("STANDARD")
  agreedRateMinor         Int? // nightly rate when different from the room type base rate (discount applied)
  discountReason          String?
  quotedTotalMinor        Int? // estimate shown at booking time; the folio is the source of truth
  // Front office
  vip                     Boolean   @default(false)
  etaTime                 String? // expected arrival time, HH:MM
  earlyCheckinRequest     String?
  lateCheckoutRequest     String?
  registrationCompletedAt DateTime?
  idVerifiedAt            DateTime?
  idVerifiedBy            String?   @db.Uuid
  noShowAt                DateTime?
  externalRef             String? // OTA or channel booking reference
  /// Rates frozen when the booking was made: { nightly: {date: minor}, extraAdultMinor, extraChildMinor, baseOccupancy }.
  /// Later changes to room-type or rate-plan prices never alter this booking.
  rateSnapshot            Json?
  ratePlanId              String?   @db.Uuid
  /// When the guest actually left, and who completed the checkout.
  actualDeparture         DateTime?
  checkedOutBy            String?   @db.Uuid

  property      Property                   @relation(fields: [propertyId], references: [id])
  guest         Guest                      @relation(fields: [guestId], references: [id])
  assignments   RoomAssignment[]
  history       ReservationStatusHistory[]
  feedback      Feedback[]
  feedbackLinks FeedbackLink[]
  folios        Folio[]

  @@unique([tenantId, reference])
  @@index([tenantId, propertyId, arrival])
  @@index([tenantId, groupRef])
  @@index([tenantId, externalRef])
  @@map("reservations")
}

model ReservationStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  reservationId String   @db.Uuid
  fromStatus    String?
  toStatus      String
  changedBy     String   @db.Uuid
  changedAt     DateTime @default(now())
  reason        String?

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@map("reservation_status_history")
}

/// Overlap prevention is enforced by a Postgres exclusion constraint
/// (see migration `room_assignment_exclusion`), not application code alone.
model RoomAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  propertyId    String   @db.Uuid
  roomId        String   @db.Uuid
  reservationId String   @db.Uuid
  arrival       DateTime @db.Date
  departure     DateTime @db.Date
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  room        Room        @relation(fields: [roomId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([tenantId, roomId])
  @@map("room_assignments")
}

// ---------- Operations ----------

model HousekeepingTask {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  propertyId            String    @db.Uuid
  roomId                String    @db.Uuid
  kind                  String    @default("DEPARTURE") // DEPARTURE | STAYOVER | PRIORITY
  status                String    @default("PENDING") // PENDING | IN_PROGRESS | AWAITING_INSPECTION | DONE | INSPECTED | CANCELLED
  assignedTo            String?   @db.Uuid
  createdAt             DateTime  @default(now())
  doneAt                DateTime?
  priority              String    @default("NORMAL") // NORMAL | HIGH | URGENT
  /// The reservation whose departure created this task, when there is one.
  reservationId         String?   @db.Uuid
  note                  String?
  startedAt             DateTime?
  inspectionRequestedAt DateTime?
  inspectedBy           String?   @db.Uuid
  inspectedAt           DateTime?
  inspectionResult      String? // PASSED | FAILED
  updatedAt             DateTime  @default(now()) @updatedAt
  updatedBy             String?   @db.Uuid
  /// Bumped on every change. A form carries the version it loaded; a different current version means a conflict.
  version               Int       @default(0)

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status])
  @@index([roomId])
  @@map("housekeeping_tasks")
}

/// Append-only log of physical room state changes (blocks, restores, housekeeping).
model RoomStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  propertyId    String   @db.Uuid
  roomId        String   @db.Uuid
  kind          String // OUT_OF_ORDER | MAINTENANCE_BLOCK | RESTORED | APPROVED | HOUSEKEEPING
  fromState     String?
  toState       String
  reason        String?
  maintenanceId String?  @db.Uuid
  changedBy     String   @db.Uuid
  changedAt     DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])

  @@index([tenantId, roomId, changedAt])
  @@map("room_status_history")
}

// ---------- Guest feedback ----------

/// The guest's original words are immutable; only `status` (complaint handling) may change. Notes live in FeedbackNote.
model Feedback {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  propertyId    String    @db.Uuid
  reservationId String?   @db.Uuid
  roomTypeId    String?   @db.Uuid
  guestName     String
  roomNumber    String?
  arrival       DateTime? @db.Date
  departure     DateTime? @db.Date
  overall       Int
  cleanliness   Int?
  service       Int?
  food          Int?
  facilities    Int?
  comments      String?
  recommend     Boolean?
  suggestions   String?
  source        String    @default("STAFF") // STAFF | LINK
  status        String    @default("NONE") // NONE | OPEN | IN_PROGRESS | RESOLVED
  submittedBy   String?   @db.Uuid
  submittedAt   DateTime  @default(now())

  reservation Reservation?   @relation(fields: [reservationId], references: [id])
  notes       FeedbackNote[]

  @@index([tenantId, propertyId, submittedAt])
  @@index([tenantId, reservationId])
  @@map("feedback")
}

/// Internal follow-up notes, kept apart from the guest's feedback. Append-only.
model FeedbackNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  feedbackId String   @db.Uuid
  note       String
  authorId   String   @db.Uuid
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id])

  @@index([tenantId, feedbackId])
  @@map("feedback_notes")
}

/// Single-use, expiring link a guest uses to leave feedback without logging in. Only the hash of the token is stored.
model FeedbackLink {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  propertyId    String    @db.Uuid
  reservationId String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdBy     String    @db.Uuid
  createdAt     DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([tenantId, reservationId])
  @@map("feedback_links")
}

// ---------- Settings ----------

/// Typed key/value settings, validated against a catalogue in code. Property settings use scopeId = propertyId,
/// tenant-wide settings use scopeId = tenantId. Secrets are stored encrypted.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  scope     String // PROPERTY | TENANT
  scopeId   String   @db.Uuid
  key       String
  value     Json
  updatedBy String   @db.Uuid
  updatedAt DateTime @updatedAt

  @@unique([tenantId, scope, scopeId, key])
  @@map("settings")
}

model MaintenanceRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  propertyId         String    @db.Uuid
  roomId             String    @db.Uuid
  title              String
  status             String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  blocksRoom         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  // Out-of-order / maintenance block details
  mode               String    @default("REPORT") // REPORT | MAINTENANCE_BLOCK | OUT_OF_ORDER
  category           String    @default("OTHER")
  priority           String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  description        String?
  reportedAt         DateTime  @default(now())
  reportedBy         String?   @db.Uuid
  startDate          DateTime? @db.Date
  expectedResolution DateTime? @db.Date
  assignedTo         String?   @db.Uuid
  approvalRequired   Boolean   @default(false)
  approvedBy         String?   @db.Uuid
  approvedAt         DateTime?
  resolutionNote     String?
  resolvedBy         String?   @db.Uuid

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status])
  @@map("maintenance_requests")
}

/// Append-only: UPDATE/DELETE blocked by DB trigger.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  propertyId String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  at         DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, at])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One-time tokens (password reset, invitations, email verification). Only a SHA-256 hash is stored.
model AuthToken {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String // RESET | INVITE | VERIFY
  tokenHash   String    @unique
  userId      String?   @db.Uuid
  email       String?
  tenantId    String?   @db.Uuid
  role        String?
  propertyIds String[]  @default([])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([kind, email])
  @@map("auth_tokens")
}

/// Development/placeholder email transport: messages are recorded here until a real provider is configured.
model EmailOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  toEmail        String
  subject        String
  body           String
  status         String    @default("QUEUED") // QUEUED | ACCEPTED | DELIVERED | BOUNCED | FAILED | TEST (SENT is the old value)
  createdAt      DateTime  @default(now())
  tenantId       String?   @db.Uuid
  reservationId  String?   @db.Uuid
  kind           String    @default("ACCOUNT") // ACCOUNT | CONFIRMATION
  provider       String?
  providerId     String?
  error          String?
  idempotencyKey String?
  sentAt         DateTime?
  deliveredAt    DateTime?

  @@index([tenantId, reservationId])
  @@index([providerId])
  @@map("email_outbox")
}

// ---------- Billing, GST, accounting (Phase 2) ----------

/// Effective-dated tax rule. Only APPROVED rules are used by the engine. Rates are basis points (1200 = 12.00%).
model TaxRule {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  category       String // ROOM | FNB | SPA | BANQUET | LAUNDRY | TRANSPORT | EXTRA_BED | OTHER
  sacCode        String?
  description    String
  treatment      String    @default("TAXABLE") // TAXABLE | EXEMPT | NIL_RATED
  rateBp         Int       @default(0)
  cessBp         Int       @default(0)
  tariffMinMinor Int? // inclusive, per unit (e.g. room per night)
  tariffMaxMinor Int? // exclusive
  placeOfSupply  String    @default("PROPERTY_STATE") // PROPERTY_STATE | RECIPIENT_STATE
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date // exclusive
  legalRef       String?
  version        Int       @default(1)
  status         String    @default("DRAFT") // DRAFT | APPROVED | RETIRED
  createdBy      String    @db.Uuid
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, category, status])
  @@map("tax_rules")
}

model Folio {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  propertyId    String   @db.Uuid
  reservationId String   @db.Uuid
  guestId       String   @db.Uuid
  status        String   @default("OPEN")
  /// GUEST is the default folio; COMPANY is a second folio billed to a company or agent.
  label         String   @default("GUEST")
  billTo        String?
  createdAt     DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  reservation Reservation  @relation(fields: [reservationId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])
  entries     FolioEntry[]
  payments    Payment[]
  refunds     Refund[]
  invoices    Invoice[]

  @@unique([reservationId, label])
  @@index([tenantId, propertyId])
  @@map("folios")
}

/// Append-only ledger line. balanceDeltaMinor is the signed effect on the amount the guest owes.
model FolioEntry {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  propertyId        String    @db.Uuid
  folioId           String    @db.Uuid
  kind              String // CHARGE | DISCOUNT | REVERSAL | PAYMENT | REFUND
  category          String
  /// Finer split inside a category for reporting (e.g. EXTRA_PERSON within ROOM). Tax is decided by `category`.
  subCategory       String?
  description       String
  quantity          Int       @default(1)
  netMinor          Int       @default(0)
  taxMinor          Int       @default(0)
  balanceDeltaMinor Int
  taxInclusive      Boolean   @default(false)
  taxDetail         Json?
  taxRuleId         String?   @db.Uuid
  serviceDate       DateTime? @db.Date
  reversesEntryId   String?   @unique @db.Uuid
  paymentId         String?   @db.Uuid
  refundId          String?   @db.Uuid
  idempotencyKey    String?
  reason            String?
  postedBy          String    @db.Uuid
  postedAt          DateTime  @default(now())

  folio Folio        @relation(fields: [folioId], references: [id])
  line  InvoiceLine?

  @@unique([tenantId, idempotencyKey])
  @@index([folioId])
  @@map("folio_entries")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  propertyId     String   @db.Uuid
  folioId        String   @db.Uuid
  method         String // CASH | UPI | CARD | BANK_TRANSFER | OTHER
  amountMinor    Int
  reference      String?
  idempotencyKey String
  shiftId        String?  @db.Uuid
  receivedBy     String   @db.Uuid
  receivedAt     DateTime @default(now())

  folio Folio      @relation(fields: [folioId], references: [id])
  shift CashShift? @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([folioId])
  @@map("payments")
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  propertyId  String   @db.Uuid
  folioId     String   @db.Uuid
  method      String
  amountMinor Int
  reason      String
  shiftId     String?  @db.Uuid
  refundedBy  String   @db.Uuid
  refundedAt  DateTime @default(now())

  folio Folio      @relation(fields: [folioId], references: [id])
  shift CashShift? @relation(fields: [shiftId], references: [id])

  @@index([folioId])
  @@map("refunds")
}

model InvoiceSequence {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  propertyId    String @db.Uuid
  series        String
  financialYear String
  next          Int    @default(1)

  @@unique([propertyId, series, financialYear])
  @@map("invoice_sequences")
}

model Invoice {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  propertyId        String   @db.Uuid
  folioId           String   @db.Uuid
  kind              String // TAX_INVOICE | BILL_OF_SUPPLY | CREDIT_NOTE | DEBIT_NOTE
  series            String
  financialYear     String
  seq               Int
  number            String
  originalInvoiceId String?  @db.Uuid
  supplier          Json
  recipient         Json
  placeOfSupply     String?
  netMinor          Int
  cgstMinor         Int      @default(0)
  sgstMinor         Int      @default(0)
  igstMinor         Int      @default(0)
  cessMinor         Int      @default(0)
  grossMinor        Int
  reason            String?
  issuedBy          String   @db.Uuid
  issuedAt          DateTime @default(now())

  property Property      @relation(fields: [propertyId], references: [id])
  folio    Folio         @relation(fields: [folioId], references: [id])
  lines    InvoiceLine[]

  @@unique([propertyId, number])
  @@index([tenantId, propertyId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  invoiceId    String  @db.Uuid
  folioEntryId String  @unique @db.Uuid
  description  String
  sacCode      String?
  quantity     Int     @default(1)
  netMinor     Int
  cgstMinor    Int     @default(0)
  sgstMinor    Int     @default(0)
  igstMinor    Int     @default(0)
  cessMinor    Int     @default(0)
  grossMinor   Int
  taxDetail    Json?

  invoice Invoice    @relation(fields: [invoiceId], references: [id])
  entry   FolioEntry @relation(fields: [folioEntryId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model CashShift {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  propertyId     String    @db.Uuid
  openedBy       String    @db.Uuid
  openedAt       DateTime  @default(now())
  openingMinor   Int
  status         String    @default("OPEN") // OPEN | CLOSED
  closedBy       String?   @db.Uuid
  closedAt       DateTime?
  countedMinor   Int?
  expectedMinor  Int?
  varianceMinor  Int?
  totals         Json?
  varianceReason String?
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime?

  property Property  @relation(fields: [propertyId], references: [id])
  payments Payment[]
  refunds  Refund[]

  @@index([tenantId, propertyId, status])
  @@map("cash_shifts")
}

model Account {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String
  type     String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE

  lines JournalLine[]

  @@unique([tenantId, code])
  @@map("accounts")
}

model JournalEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String?  @db.Uuid
  date       DateTime @db.Date
  memo       String
  sourceType String
  sourceId   String
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())

  lines JournalLine[]

  @@unique([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  entryId     String @db.Uuid
  accountId   String @db.Uuid
  debitMinor  Int    @default(0)
  creditMinor Int    @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([tenantId, accountId])
  @@map("journal_lines")
}

/// Saved progress of the setup wizard so it can be resumed.
model OnboardingState {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  propertyId  String    @unique @db.Uuid
  step        Int       @default(0)
  data        Json      @default("{}")
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("onboarding_states")
}

// ---------- WhatsApp messaging ----------

model MessageTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  key        String
  body       String
  /// Twilio Content SID of the approved WhatsApp template, when the provider requires one.
  contentSid String?
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, key])
  @@index([tenantId])
  @@map("message_templates")
}

model GuestConsent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  guestId    String   @db.Uuid
  channel    String   @default("WHATSAPP")
  status     String // GRANTED | REVOKED
  source     String // how consent was obtained, e.g. "Verbal at check-in", "Booking form"
  recordedBy String   @db.Uuid
  at         DateTime @default(now())

  @@unique([guestId, channel])
  @@index([tenantId])
  @@map("guest_consents")
}

/// One row per message attempt target. Message text is not stored; only the template key and delivery facts.
model MessageLog {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  propertyId        String   @db.Uuid
  guestId           String   @db.Uuid
  reservationId     String?  @db.Uuid
  templateKey       String
  toMasked          String
  provider          String // TWILIO | TEST
  providerMessageId String?
  status            String // PENDING | SENT | DELIVERED | FAILED | TEST
  error             String?
  attempts          Int      @default(0)
  idempotencyKey    String
  createdBy         String   @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([propertyId, idempotencyKey])
  @@index([tenantId, propertyId, createdAt])
  @@index([providerMessageId])
  @@map("message_logs")
}

/// Acknowledgement or resolution of a derived alert (alerts themselves are computed live from data).
model AlertAck {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String   @db.Uuid
  alertKey   String
  status     String // ACKNOWLEDGED | RESOLVED
  note       String?
  by         String   @db.Uuid
  at         DateTime @default(now())

  @@unique([propertyId, alertKey])
  @@index([tenantId, propertyId])
  @@map("alert_acks")
}

// ---------- Rate plans ----------

/// A priced offer for one or more room categories. Pre-tax: GST comes from the tax rules. Existing bookings keep their
/// own frozen rates (Reservation.rateSnapshot), so editing a plan never reprices them.
model RatePlan {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  propertyId  String    @db.Uuid
  name        String
  code        String
  description String?
  active      Boolean   @default(true)
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  /// Higher wins when plans overlap; then the narrower date window; then the newer plan.
  priority    Int       @default(0)
  /// Days charged the weekend rate, 0 = Sunday .. 6 = Saturday.
  weekendDays Int[]     @default([5, 6])
  mealPlan    String    @default("ROOM_ONLY") // ROOM_ONLY | BREAKFAST | HALF_BOARD | FULL_BOARD
  refundable  Boolean   @default(true)
  minStay     Int?
  maxStay     Int?
  taxNote     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  property Property       @relation(fields: [propertyId], references: [id])
  rates    RatePlanRate[]

  @@unique([propertyId, code])
  @@index([tenantId, propertyId])
  @@map("rate_plans")
}

model RatePlanRate {
  id                       String @id @default(uuid()) @db.Uuid
  tenantId                 String @db.Uuid
  ratePlanId               String @db.Uuid
  roomTypeId               String @db.Uuid
  weekdayRateMinor         Int
  weekendRateMinor         Int?
  singleOccupancyRateMinor Int?
  extraAdultRateMinor      Int?
  extraChildRateMinor      Int?

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([ratePlanId, roomTypeId])
  @@index([tenantId])
  @@map("rate_plan_rates")
}

// ---------- In-app notifications ----------

/// One row per event. `dedupeKey` makes the same event notify once. Who sees it is decided by `audiencePerm`.
model AppNotification {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  propertyId   String   @db.Uuid
  dedupeKey    String
  kind         String
  title        String
  body         String?
  href         String?
  audiencePerm String
  createdAt    DateTime @default(now())

  reads NotificationRead[]

  @@unique([propertyId, dedupeKey])
  @@index([tenantId, propertyId, createdAt])
  @@map("app_notifications")
}

model NotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  tenantId       String   @db.Uuid
  readAt         DateTime @default(now())

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([tenantId, userId])
  @@map("notification_reads")
}

// ---------- Subscriptions (the software provider's own billing; never mixed with hotel guest billing) ----------

/// A sellable plan. Limits are null for "unlimited". Prices are paise per month; the annual price is derived from
/// annualDiscountBps unless annualPriceMinor is set. Edited by the platform administrator, never hardcoded.
model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  description       String   @default("")
  active            Boolean  @default(true)
  isPublic          Boolean  @default(true)
  sortOrder         Int      @default(0)
  monthlyPriceMinor Int      @default(0)
  annualPriceMinor  Int?
  annualDiscountBps Int      @default(1667)
  currency          String   @default("INR")
  trialDays         Int      @default(14)
  customPricing     Boolean  @default(false)
  maxProperties     Int?
  maxRooms          Int?
  maxUsers          Int?
  maxStorageMb      Int?
  maxIntegrations   Int?
  features          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model PlanAddon {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  description       String   @default("")
  monthlyPriceMinor Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@map("plan_addons")
}

model Coupon {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  description    String    @default("")
  kind           String // PERCENT | AMOUNT
  value          Int // basis points for PERCENT, paise for AMOUNT
  months         Int       @default(1) // how many billing periods the discount applies to
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  redeemed       Int       @default(0)
  planCodes      String[]  @default([]) // empty = every plan
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  subscriptions Subscription[]

  @@map("coupons")
}

model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @unique @db.Uuid
  planId             String    @db.Uuid
  interval           String    @default("MONTHLY") // MONTHLY | ANNUAL
  status             String    @default("TRIAL") // TRIAL | ACTIVE | PAYMENT_DUE | PAST_DUE | SUSPENDED | CANCELLED | EXPIRED
  trialEndsAt        DateTime?
  periodStart        DateTime?
  periodEnd          DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  graceEndsAt        DateTime?
  couponId           String?   @db.Uuid
  couponMonthsLeft   Int       @default(0)
  priceOverrideMinor Int?
  pendingPlanId      String?   @db.Uuid
  pendingInterval    String?
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  plan   Plan    @relation(fields: [planId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([status, periodEnd])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  subscriptionId String    @db.Uuid
  number         String    @unique
  kind           String // NEW | RENEWAL | UPGRADE
  status         String    @default("OPEN") // OPEN | PAID | VOID
  lines          Json
  netMinor       Int
  taxBps         Int       @default(0)
  taxMinor       Int       @default(0)
  grossMinor     Int
  issuedAt       DateTime  @default(now())
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, status])
  @@index([subscriptionId])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  invoiceId      String   @db.Uuid
  amountMinor    Int
  method         String // BANK_TRANSFER | UPI | CASH | CHEQUE | OTHER
  reference      String   @default("")
  status         String   @default("SUCCEEDED") // SUCCEEDED | FAILED
  idempotencyKey String   @unique
  recordedBy     String?  @db.Uuid
  note           String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@map("subscription_payments")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  subscriptionId String   @db.Uuid
  type           String
  detail         Json     @default("{}")
  actorId        String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("subscription_events")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// Numbered series for the provider's own invoices, one counter per financial year.
model PlatformCounter {
  key   String @id
  value Int    @default(0)

  @@map("platform_counters")
}

model Lead {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String   @default("CONTACT") // CONTACT | DEMO
  name         String
  hotel        String
  mobile       String
  email        String
  rooms        Int?
  properties   Int?
  integrations String?
  message      String?
  status       String   @default("NEW") // NEW | CONTACTED | CLOSED
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("leads")
}
