generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity & tenancy ----------

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  legalName   String
  displayName String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  properties  Property[]
  guests      Guest[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  mfaSecretEnc String?
  mfaEnabled   Boolean  @default(false)
  emailVerifiedAt DateTime?
  sessionEpoch Int      @default(0) // bump to revoke all sessions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  role      String // RoleKey
  extraPermissions String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  properties UserProperty[]

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model Property {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  address       String?
  timezone      String   @default("Asia/Kolkata")
  currency      String   @default("INR")
  checkInTime   String   @default("14:00")
  checkOutTime  String   @default("11:00")
  legalName     String?
  gstRegistered Boolean  @default(false)
  gstin         String?
  gstStateCode  String?
  invoicePrefix String   @default("INV")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  users        UserProperty[]
  roomTypes    RoomType[]
  rooms        Room[]
  reservations Reservation[]
  tasks        HousekeepingTask[]
  maintenance  MaintenanceRequest[]
  folios       Folio[]
  shifts       CashShift[]
  invoices     Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("properties")
}

model UserProperty {
  membershipId String @db.Uuid
  propertyId   String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id])
  property   Property   @relation(fields: [propertyId], references: [id])

  @@id([membershipId, propertyId])
  @@map("user_property_roles")
}

// ---------- Rooms ----------

model RoomType {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  propertyId   String @db.Uuid
  name         String
  maxAdults    Int    @default(2)
  maxChildren  Int    @default(0)
  baseRateMinor Int   @default(0) // integer minor units (paise)
  createdAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  rooms    Room[]

  @@index([tenantId, propertyId])
  @@map("room_types")
}

model Room {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  propertyId     String  @db.Uuid
  roomTypeId     String  @db.Uuid
  number         String
  // Operational status; separate from booking state.
  housekeeping   String  @default("CLEAN") // CLEAN | DIRTY | CLEANING | INSPECTED
  outOfOrder     Boolean @default(false)
  floor          Int?
  createdAt      DateTime @default(now())

  property    Property   @relation(fields: [propertyId], references: [id])
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
  assignments RoomAssignment[]
  tasks       HousekeepingTask[]
  maintenance MaintenanceRequest[]
  statusHistory RoomStatusHistory[]

  @@unique([propertyId, number])
  @@index([tenantId, propertyId])
  @@map("rooms")
}

// ---------- Guests & reservations ----------

model Guest {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  phone     String?
  email     String?
  notes     String?
  companyName  String?
  gstin        String?
  gstStateCode String?
  address      String?
  idType       String?
  idNumberEnc  String? // AES-GCM encrypted; shown masked
  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reservations Reservation[]
  folios       Folio[]

  @@index([tenantId])
  @@map("guests")
}

model Reservation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  propertyId  String   @db.Uuid
  reference   String
  guestId     String   @db.Uuid
  roomTypeId  String   @db.Uuid
  source      String   @default("DIRECT")
  arrival     DateTime @db.Date
  departure   DateTime @db.Date
  adults      Int      @default(1)
  children    Int      @default(0)
  status      String   @default("CONFIRMED")
  notes       String?
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Booking details (multi-room bookings share a groupRef)
  groupRef        String?
  companyName     String?
  agentName       String?
  ratePlan        String  @default("STANDARD")
  agreedRateMinor Int? // nightly rate when different from the room type base rate (discount applied)
  discountReason  String?
  quotedTotalMinor Int? // estimate shown at booking time; the folio is the source of truth

  property    Property @relation(fields: [propertyId], references: [id])
  guest       Guest    @relation(fields: [guestId], references: [id])
  assignments RoomAssignment[]
  history     ReservationStatusHistory[]
  folios      Folio[]

  @@unique([tenantId, reference])
  @@index([tenantId, propertyId, arrival])
  @@index([tenantId, groupRef])
  @@map("reservations")
}

model ReservationStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  reservationId String   @db.Uuid
  fromStatus    String?
  toStatus      String
  changedBy     String   @db.Uuid
  changedAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@map("reservation_status_history")
}

/// Overlap prevention is enforced by a Postgres exclusion constraint
/// (see migration `room_assignment_exclusion`), not application code alone.
model RoomAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  propertyId    String   @db.Uuid
  roomId        String   @db.Uuid
  reservationId String   @db.Uuid
  arrival       DateTime @db.Date
  departure     DateTime @db.Date
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  room        Room        @relation(fields: [roomId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([tenantId, roomId])
  @@map("room_assignments")
}

// ---------- Operations ----------

model HousekeepingTask {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  propertyId String    @db.Uuid
  roomId     String    @db.Uuid
  kind       String    @default("DEPARTURE") // DEPARTURE | STAYOVER | PRIORITY
  status     String    @default("PENDING") // PENDING | IN_PROGRESS | DONE | INSPECTED
  assignedTo String?   @db.Uuid
  createdAt  DateTime  @default(now())
  doneAt     DateTime?

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status])
  @@map("housekeeping_tasks")
}

/// Append-only log of physical room state changes (blocks, restores, housekeeping).
model RoomStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  propertyId    String   @db.Uuid
  roomId        String   @db.Uuid
  kind          String // OUT_OF_ORDER | MAINTENANCE_BLOCK | RESTORED | APPROVED | HOUSEKEEPING
  fromState     String?
  toState       String
  reason        String?
  maintenanceId String?  @db.Uuid
  changedBy     String   @db.Uuid
  changedAt     DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])

  @@index([tenantId, roomId, changedAt])
  @@map("room_status_history")
}

model MaintenanceRequest {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  propertyId String    @db.Uuid
  roomId     String    @db.Uuid
  title      String
  status     String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  blocksRoom Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  // Out-of-order / maintenance block details
  mode               String    @default("REPORT") // REPORT | MAINTENANCE_BLOCK | OUT_OF_ORDER
  category           String    @default("OTHER")
  priority           String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  description        String?
  reportedAt         DateTime  @default(now())
  reportedBy         String?   @db.Uuid
  startDate          DateTime? @db.Date
  expectedResolution DateTime? @db.Date
  assignedTo         String?   @db.Uuid
  approvalRequired   Boolean   @default(false)
  approvedBy         String?   @db.Uuid
  approvedAt         DateTime?
  resolutionNote     String?
  resolvedBy         String?   @db.Uuid

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status])
  @@map("maintenance_requests")
}

/// Append-only: UPDATE/DELETE blocked by DB trigger.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  propertyId String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  at         DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, at])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One-time tokens (password reset, invitations, email verification). Only a SHA-256 hash is stored.
model AuthToken {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String // RESET | INVITE | VERIFY
  tokenHash   String    @unique
  userId      String?   @db.Uuid
  email       String?
  tenantId    String?   @db.Uuid
  role        String?
  propertyIds String[]  @default([])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([kind, email])
  @@map("auth_tokens")
}

/// Development/placeholder email transport: messages are recorded here until a real provider is configured.
model EmailOutbox {
  id        String   @id @default(uuid()) @db.Uuid
  toEmail   String
  subject   String
  body      String
  status    String   @default("QUEUED") // QUEUED | SENT | FAILED
  createdAt DateTime @default(now())

  @@map("email_outbox")
}

// ---------- Billing, GST, accounting (Phase 2) ----------

/// Effective-dated tax rule. Only APPROVED rules are used by the engine. Rates are basis points (1200 = 12.00%).
model TaxRule {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  category       String // ROOM | FNB | SPA | BANQUET | LAUNDRY | TRANSPORT | EXTRA_BED | OTHER
  sacCode        String?
  description    String
  treatment      String    @default("TAXABLE") // TAXABLE | EXEMPT | NIL_RATED
  rateBp         Int       @default(0)
  cessBp         Int       @default(0)
  tariffMinMinor Int? // inclusive, per unit (e.g. room per night)
  tariffMaxMinor Int? // exclusive
  placeOfSupply  String    @default("PROPERTY_STATE") // PROPERTY_STATE | RECIPIENT_STATE
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date // exclusive
  legalRef       String?
  version        Int       @default(1)
  status         String    @default("DRAFT") // DRAFT | APPROVED | RETIRED
  createdBy      String    @db.Uuid
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, category, status])
  @@map("tax_rules")
}

model Folio {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  propertyId    String   @db.Uuid
  reservationId String   @db.Uuid
  guestId       String   @db.Uuid
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  reservation Reservation  @relation(fields: [reservationId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])
  entries     FolioEntry[]
  payments    Payment[]
  refunds     Refund[]
  invoices    Invoice[]

  @@unique([reservationId])
  @@index([tenantId, propertyId])
  @@map("folios")
}

/// Append-only ledger line. balanceDeltaMinor is the signed effect on the amount the guest owes.
model FolioEntry {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  propertyId        String    @db.Uuid
  folioId           String    @db.Uuid
  kind              String // CHARGE | DISCOUNT | REVERSAL | PAYMENT | REFUND
  category          String
  description       String
  quantity          Int       @default(1)
  netMinor          Int       @default(0)
  taxMinor          Int       @default(0)
  balanceDeltaMinor Int
  taxInclusive      Boolean   @default(false)
  taxDetail         Json?
  taxRuleId         String?   @db.Uuid
  serviceDate       DateTime? @db.Date
  reversesEntryId   String?   @unique @db.Uuid
  paymentId         String?   @db.Uuid
  refundId          String?   @db.Uuid
  idempotencyKey    String?
  reason            String?
  postedBy          String    @db.Uuid
  postedAt          DateTime  @default(now())

  folio Folio       @relation(fields: [folioId], references: [id])
  line  InvoiceLine?

  @@unique([tenantId, idempotencyKey])
  @@index([folioId])
  @@map("folio_entries")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  propertyId     String   @db.Uuid
  folioId        String   @db.Uuid
  method         String // CASH | UPI | CARD | BANK_TRANSFER | OTHER
  amountMinor    Int
  reference      String?
  idempotencyKey String
  shiftId        String?  @db.Uuid
  receivedBy     String   @db.Uuid
  receivedAt     DateTime @default(now())

  folio Folio      @relation(fields: [folioId], references: [id])
  shift CashShift? @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([folioId])
  @@map("payments")
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  propertyId  String   @db.Uuid
  folioId     String   @db.Uuid
  method      String
  amountMinor Int
  reason      String
  shiftId     String?  @db.Uuid
  refundedBy  String   @db.Uuid
  refundedAt  DateTime @default(now())

  folio Folio      @relation(fields: [folioId], references: [id])
  shift CashShift? @relation(fields: [shiftId], references: [id])

  @@index([folioId])
  @@map("refunds")
}

model InvoiceSequence {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  propertyId    String @db.Uuid
  series        String
  financialYear String
  next          Int    @default(1)

  @@unique([propertyId, series, financialYear])
  @@map("invoice_sequences")
}

model Invoice {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  propertyId        String   @db.Uuid
  folioId           String   @db.Uuid
  kind              String // TAX_INVOICE | BILL_OF_SUPPLY | CREDIT_NOTE | DEBIT_NOTE
  series            String
  financialYear     String
  seq               Int
  number            String
  originalInvoiceId String?  @db.Uuid
  supplier          Json
  recipient         Json
  placeOfSupply     String?
  netMinor          Int
  cgstMinor         Int      @default(0)
  sgstMinor         Int      @default(0)
  igstMinor         Int      @default(0)
  cessMinor         Int      @default(0)
  grossMinor        Int
  reason            String?
  issuedBy          String   @db.Uuid
  issuedAt          DateTime @default(now())

  property Property      @relation(fields: [propertyId], references: [id])
  folio    Folio         @relation(fields: [folioId], references: [id])
  lines    InvoiceLine[]

  @@unique([propertyId, number])
  @@index([tenantId, propertyId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  invoiceId    String @db.Uuid
  folioEntryId String @unique @db.Uuid
  description  String
  sacCode      String?
  quantity     Int    @default(1)
  netMinor     Int
  cgstMinor    Int    @default(0)
  sgstMinor    Int    @default(0)
  igstMinor    Int    @default(0)
  cessMinor    Int    @default(0)
  grossMinor   Int
  taxDetail    Json?

  invoice Invoice    @relation(fields: [invoiceId], references: [id])
  entry   FolioEntry @relation(fields: [folioEntryId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model CashShift {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  propertyId     String    @db.Uuid
  openedBy       String    @db.Uuid
  openedAt       DateTime  @default(now())
  openingMinor   Int
  status         String    @default("OPEN") // OPEN | CLOSED
  closedBy       String?   @db.Uuid
  closedAt       DateTime?
  countedMinor   Int?
  expectedMinor  Int?
  varianceMinor  Int?
  totals         Json?
  varianceReason String?
  approvedBy     String?   @db.Uuid
  approvedAt     DateTime?

  property Property  @relation(fields: [propertyId], references: [id])
  payments Payment[]
  refunds  Refund[]

  @@index([tenantId, propertyId, status])
  @@map("cash_shifts")
}

model Account {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String
  type     String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE

  lines JournalLine[]

  @@unique([tenantId, code])
  @@map("accounts")
}

model JournalEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  propertyId String?  @db.Uuid
  date       DateTime @db.Date
  memo       String
  sourceType String
  sourceId   String
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())

  lines JournalLine[]

  @@unique([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  entryId     String @db.Uuid
  accountId   String @db.Uuid
  debitMinor  Int    @default(0)
  creditMinor Int    @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([tenantId, accountId])
  @@map("journal_lines")
}
